# --- environment -----------------------------------------------------------
fault-env/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# --- data (BGL.log is public: Loghub; everything else is rebuilt by v2/build_dataset.py)
data/

# --- model weights (rebuilt by run_all.bat); keep the small selection files
models/*
!models/selected.json
!models/demo_slices.json

# --- results: keep reports, plots, tables, metrics and training logs; drop bulky/runtime files
results/*.npy
results/live_events.jsonl
results/live_events_eval.jsonl
results/daemon_dashboard.log
results/log_daemon_live.txt
results/deck_preview/

# --- throwaway demo training runs (e.g. --name distilbert_abl_epochdemo / hgb_abl_epochdemo)
*epochdemo*

# --- screenshots for the deck (kept locally)
screenshots/

# --- local tooling / OS
.claude/
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
~$*
